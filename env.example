# =============================================================================
#  邻食 NF — 环境变量单文件说明（不自动加载，请按需复制到各应用）
#   Web：  将下方「1. Web」中需要的行复制到 apps/web/.env.local
#   API：  将下方「2. API」复制到 apps/api/.env
#  Next 识图只读 apps/web 下的 .env*；填好 RECOGNIZE_API_KEY 即可真识图。
# =============================================================================

# ----- 1. Web（@lin-shi/web）→ 复制到 apps/web/.env.local --------------------

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_UPLOADS_URL=http://localhost:3000/uploads

# 拍照识图（Next Route：POST /api/ingredients/recognize）
# 有 key 即走真多模态；未填时返回内置假数据（青椒/土豆），除非设 RECOGNIZE_MOCK=false
RECOGNIZE_API_KEY=
# 以下可选，默认值已写在代码里，无需写满三个
# RECOGNIZE_MODEL=step-1o-turbo-vision
# RECOGNIZE_BASE_URL=https://api.stepfun.com/v1
# 覆盖默认提示词时再用
# RECOGNIZE_QUESTION=   # 覆盖 user 条默认文案（同 culinabot 的 question）
# RECOGNIZE_SYSTEM=     # 覆盖与 Culina 第 1 步对齐的 system，一般不必填
# 强制：true=永远假识图，false=必须有 key 否则 503
# RECOGNIZE_MOCK=

# ----- 2. API（@lin-shi/api）→ 复制到 apps/api/.env --------------------------

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lin_shi

JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret_string__
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_another_32_chars_refresh_secret_string
JWT_REFRESH_TTL=7d

UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_URL=http://localhost:3000/uploads

CORS_ORIGIN=http://localhost:3001

AI_VISION_API_KEY=
AI_VISION_ENDPOINT=

# Nest `POST /ingredients/recognize`：全量 Culina（LangChain+Tavily）在 TS 中由 `@lin-shi/culina-agent` 实现。
# 未设 CULINABOT_URL 且 CULINABOT_USE_TYPESCRIPT=true（默认）时，进程内调用；为 false 时需另起同构 HTTP：根目录 pnpm dev:culina（:7860）并填 CULINABOT_URL
# CULINABOT_URL=http://127.0.0.1:7860
# CULINABOT_USE_TYPESCRIPT=true
# 可与上表 RECOGNIZE_* 使用同一组 key（避免重复命名：也可用下方三项，与旧版一致）
# CULINABOT_LLM_API_KEY=
# CULINABOT_LLM_BASE_URL=https://api.stepfun.com/v1
# CULINABOT_LLM_MODEL=step-1o-turbo-vision
# CULINABOT_TAVILY_API_KEY=
# CULINABOT_QUESTION=

RECIPE_API_KEY=
MATCH_LLM_API_KEY=
SOCKET_CORS_ORIGIN=

EXTERNAL_USE_MOCK=true
INGREDIENTS_DEV_BYPASS_AUTH=true
