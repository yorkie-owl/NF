{
  "name": "@lin-shi/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync(require('node:path').join(process.cwd(),'.next'),{recursive:true,force:true}); console.log('removed .next')\"",
    "dev": "next dev -p 3001",
    "dev:turbo": "next dev -p 3001 --turbo",
    "dev:clean": "pnpm clean && next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@lin-shi/contracts": "workspace:*",
    "lucide-react": "^0.468.0",
    "ky": "^1.7.4",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4"
  }
}
