# 完整清单见仓库根目录 env.example
# 本文件为 Web 常用项；识图有下面一项即够（其余有代码默认值）

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_UPLOADS_URL=http://localhost:3000/uploads

# 阶跃/其它 OpenAI 兼容多模态；填了即真识图，不填为假识图
RECOGNIZE_API_KEY=
# 可选
# RECOGNIZE_MODEL=step-1o-turbo-vision
# RECOGNIZE_BASE_URL=https://api.stepfun.com/v1
# RECOGNIZE_QUESTION=   # 用户侧指令，默认同 contracts 中 Culina 同步文案
# RECOGNIZE_SYSTEM=     # 可选；覆盖与 Culina 第 1 步对齐的 system
# RECOGNIZE_MOCK=true   # 强制假识图  |  RECOGNIZE_MOCK=false 没 key 时 503

# OPC 拼桌助理：客户端只配 server 地址；LLM key 在 culina-server 进程 env，不进 bundle
NEXT_PUBLIC_CULINA_SERVER=http://127.0.0.1:7860
# culina-server 那边的 env（在 apps/culina-server 起进程时设，不写到本文件）：
#   OPC_AGENT_KEY=...
#   OPC_AGENT_BASE_URL=https://your-openai-compatible-endpoint/v1
#   OPC_AGENT_MODEL=your-model-name
