NODE_ENV=development
PORT=3000

DB_HOST=localhost
# 与根目录 docker-compose 映射一致（宿主机 5433 -> 容器 5432）；若你停掉本机 PG 并改回 5432:5432，这里改为 5432
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lin_shi

# Generate strong secrets for production; each must be at least 32 characters.
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret_string__
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_another_32_chars_refresh_secret_string
JWT_REFRESH_TTL=7d

UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_URL=http://localhost:3000/uploads

CORS_ORIGIN=http://localhost:3001

AI_VISION_API_KEY=
AI_VISION_ENDPOINT=

# 前端识图见 apps/web 与根 env.example。Nest 的 `ingredients/recognize` 全量 Culina 见 `packages/culina-agent`；默认进程内 TS，无需 7860。
# CULINABOT_URL=http://127.0.0.1:7860
# CULINABOT_USE_TYPESCRIPT=true
# CULINABOT_LLM_API_KEY=
# CULINABOT_LLM_BASE_URL=https://api.stepfun.com/v1
# CULINABOT_LLM_MODEL=step-1o-turbo-vision
# CULINABOT_TAVILY_API_KEY=
# CULINABOT_QUESTION=

RECIPE_API_KEY=
MATCH_LLM_API_KEY=
SOCKET_CORS_ORIGIN=

EXTERNAL_USE_MOCK=true

# B 开发：无 JWT 时用 query userId；生产接入队友 A 后设为 false
INGREDIENTS_DEV_BYPASS_AUTH=true
