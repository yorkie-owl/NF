NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lin_shi

# Generate strong secrets for production; each must be at least 32 characters.
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_secret_string__
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_another_32_chars_refresh_secret_string
JWT_REFRESH_TTL=7d

UPLOADS_DIR=./uploads
UPLOADS_PUBLIC_URL=http://localhost:3000/uploads

CORS_ORIGIN=http://localhost:3001

AI_VISION_API_KEY=
AI_VISION_ENDPOINT=

# CulinaBot（CulinaBot(1)/CulinaBot/web_test.py）。不配置 CULINABOT_URL 则识图为 mock。
# CULINABOT_URL=http://127.0.0.1:7860
# ---- 多模态 LLM：阶跃星辰 StepFun（OpenAI 兼容，视觉见文档）----
# 密钥：https://platform.stepfun.com/interface-key
# 概览：https://platform.stepfun.com/docs/zh/quickstart/overview
# 图片理解 / 推荐模型 step-1o-turbo-vision：https://platform.stepfun.com/docs/zh/guides/developer/image-chat
# CULINABOT_LLM_API_KEY=请填_STEP_API_KEY
# CULINABOT_LLM_BASE_URL=https://api.stepfun.com/v1
# CULINABOT_LLM_MODEL=step-1o-turbo-vision
# ---- 其它云（例：火山豆包，可按需改）----
# CULINABOT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# CULINABOT_LLM_MODEL=doubao-seed-1-6-251015
# CULINABOT_TAVILY_API_KEY=
# CULINABOT_QUESTION=

RECIPE_API_KEY=
MATCH_LLM_API_KEY=
SOCKET_CORS_ORIGIN=

EXTERNAL_USE_MOCK=true

# B 开发：无 JWT 时用 query userId；生产接入队友 A 后设为 false
INGREDIENTS_DEV_BYPASS_AUTH=true
